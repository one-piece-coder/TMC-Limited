# Photo identification
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Stripe (Pro subscriptions)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRO_PRICE_LABEL=$4.99/month
# FREE_SCANS_PER_MONTH=3
# PRO_SCANS_PER_MONTH=100

# Affiliate links
AMAZON_ASSOCIATE_TAG=
# PARTS_RETAILERS=[{"name":"PartsCo","template":"https://partsco.example/search?q={query}&aff=123"}]

# Email (password reset). Without SMTP_URL, dev mode prints emails to the console.
SMTP_URL=
EMAIL_FROM=FixIt Home <help@your-domain.com>

# Owner setup: the one-time code to claim the site at /#/setup.
# If blank, a random code is printed in the server log at startup.
SETUP_CODE=

# Deployment
# APP_URL=https://your-domain.com
# DATABASE_PATH=data/fixit.db
# TRUST_PROXY=1
# NODE_ENV=production
